                    title="Log Out / Reset"
                    className="w-9 h-9 rounded-xl bg-neutral-900/80 backdrop-blur-md border border-neutral-700/60 flex items-center justify-center text-white/90 hover:text-[#a3e635] transition-colors"
                  >
                    <SquarePen className="w-4 h-4" />
                  </button>
                </div>

                {/* Score & Timer Badge */}
                <div className="flex justify-center mt-3">
                  <div className="bg-black/60 backdrop-blur-md border border-neutral-700/50 rounded-2xl px-4 py-1.5 flex items-center space-x-4 shadow-xl">
                    <div className="flex items-center space-x-2">
                      <div className="w-5 h-4 bg-rose-600 rounded flex items-center justify-center text-[10px] text-white">
                        🥊
                      </div>
                      <div className="w-3 h-3 rounded-full bg-[#a3e635] shadow-[0_0_6px_#a3e635]" />
                      <span className="text-xl font-black text-white tracking-wider">12</span>
                    </div>
                    <div className="h-4 w-[1px] bg-neutral-700" />
                    <span className="text-xl font-mono font-bold text-white tracking-wider">10:00</span>
                  </div>
                </div>
              </div>

              {/* Action Controls */}
              <div className="relative z-20 flex-1 flex justify-end items-end px-4 pb-2">
                <div className="flex flex-col items-center space-y-4 mb-2">
                  <div className="relative mb-1">
                    <div className="w-12 h-12 rounded-full border-2 border-white overflow-hidden bg-neutral-800 shadow-lg">
                      <img 
                        src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80" 
                        alt="Creator" 
                        className="w-full h-full object-cover"
                      />
                    </div>
                    <div className="absolute -bottom-1 -left-1 w-5 h-3.5 rounded-xs overflow-hidden border border-white/80 shadow">
                      <svg viewBox="0 0 7410 3900" className="w-full h-full">
                        <rect width="7410" height="3900" fill="#b22234"/>
                        <path d="M0,450H7410M0,1050H7410M0,1650H7410M0,2250H7410M0,2850H7410M0,3450H7410" stroke="#fff" strokeWidth="300"/>
                        <rect width="2964" height="2100" fill="#3c3b6e"/>
                      </svg>
                    </div>
                    <button className="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-[#a3e635] text-black flex items-center justify-center font-bold text-xs shadow hover:scale-110 transition-transform">
                      <Plus className="w-3 h-3 stroke-[3]" />
                    </button>
                  </div>

                  <button 
                    onClick={() => {
                      setIsLiked(!isLiked);
                      showToast(isLiked ? 'Unliked' : 'Liked post!', 'success');
                    }}
                    className="flex flex-col items-center group cursor-pointer"
                  >
                    <div className="w-10 h-10 rounded-full flex items-center justify-center bg-black/30 backdrop-blur-xs group-hover:scale-110 transition-transform">
                      <Heart className={`w-7 h-7 drop-shadow-md ${isLiked ? 'text-rose-500 fill-rose-500' : 'text-white'}`} />
                    </div>
                    <span className="text-[11px] font-medium text-white/95 mt-0.5 shadow-xs">Like</span>
                  </button>

                  <button 
                    onClick={() => showToast('Comments section opened', 'info')}
                    className="flex flex-col items-center group cursor-pointer"
                  >
                    <div className="w-10 h-10 rounded-full flex items-center justify-center bg-black/30 backdrop-blur-xs group-hover:scale-110 transition-transform">
                      <MessageSquare className="w-7 h-7 text-white drop-shadow-md" />
                    </div>
                    <span className="text-[11px] font-medium text-white/95 mt-0.5 shadow-xs">Comment</span>
                  </button>

                  <button 
                    onClick={() => {
                      setIsSaved(!isSaved);
                      showToast(isSaved ? 'Removed from saved' : 'Saved to favorites', 'success');
                    }}
                    className="flex flex-col items-center group cursor-pointer"
                  >
                    <div className="w-10 h-10 rounded-full flex items-center justify-center bg-black/30 backdrop-blur-xs group-hover:scale-110 transition-transform">
                      <Bookmark className={`w-7 h-7 drop-shadow-md ${isSaved ? 'text-amber-400 fill-amber-400' : 'text-white'}`} />
                    </div>
                    <span className="text-[11px] font-medium text-white/95 mt-0.5 shadow-xs">Save</span>
                  </button>

                  <button 
                    onClick={() => showToast('Share link copied to clipboard', 'success')}
                    className="flex flex-col items-center group cursor-pointer"
                  >
                    <div className="w-10 h-10 rounded-full flex items-center justify-center bg-black/30 backdrop-blur-xs group-hover:scale-110 transition-transform">
                      <Share2 className="w-7 h-7 text-white drop-shadow-md" />
                    </div>
                    <span className="text-[11px] font-medium text-white/95 mt-0.5 shadow-xs">Share</span>
                  </button>

                  <button 
                    onClick={() => showToast('Options: Report, Mute, QR Code', 'info')}
                    className="w-10 h-10 rounded-full flex items-center justify-center text-white/90 hover:text-white"
                  >
                    <MoreVertical className="w-6 h-6 drop-shadow-md" />
                  </button>
                </div>
              </div>

              {/* Bottom Caption Overlay */}
              <div className="relative z-20 px-4 pb-2 space-y-1.5">
                <div className="inline-flex items-center space-x-2 bg-gradient-to-r from-[#9fe800] to-[#00f2fe] text-black font-extrabold text-[11px] px-3 py-1 rounded-full shadow-[0_0_12px_rgba(159,232,0,0.4)]">
                  <div className="flex items-center space-x-1">
                    <Clock className="w-3.5 h-3.5 stroke-[2.5]" />
                    <span>5 SEC MAX</span>
                  </div>
                  <span className="text-black/40 font-normal">|</span>
                  <div className="flex items-center">
                    <span>WEEK #123</span>
                    <ChevronRight className="w-3.5 h-3.5 stroke-[3] ml-0.5" />
                  </div>
                </div>

                <div className="text-base font-bold text-white tracking-tight flex items-center space-x-1">
                  <span>@{displayName || username || 'RyanG'}</span>
                </div>

                <div className="flex items-center space-x-1.5 text-xs text-white/90">
                  <span className="w-4 h-4 rounded-full bg-emerald-500 text-black flex items-center justify-center text-[10px] font-bold">✓</span>
                  <span className="font-semibold">26 hits in 10 seconds</span>
                </div>

                <p className="text-xs text-white/80 leading-relaxed pr-12">
                  Your team is global. Your payments should be too. Your team is global.
                  <button 
                    onClick={() => setShowFullCaption(!showFullCaption)}
                    className="text-[#a3e635] ml-1.5 font-medium hover:underline inline-block"
                  >
                    {showFullCaption ? 'hide' : 'less'}
                  </button>
                </p>

                <div className="flex items-center space-x-3 text-[11px] text-white/60 pt-0.5">
                  <span>2025-01-04</span>
                  <div className="flex items-center space-x-1">
                    <MapPin className="w-3 h-3 text-white/70" />
                    <span className="truncate max-w-[200px]">456 Innovation Drive, Suite...</span>
                  </div>
                </div>
              </div>

              {/* Bottom Tab Bar */}
              <div className="relative z-30 bg-black/95 border-t border-neutral-800/80 px-6 pt-2 pb-5 flex items-center justify-between">
                <button className="flex flex-col items-center text-white">
                  <Home className="w-6 h-6 stroke-[2.4]" />
                </button>
                <button 
                  onClick={() => showToast('Stats view opened', 'info')}
                  className="flex flex-col items-center text-neutral-400 hover:text-white transition-colors"
                >
                  <BarChart2 className="w-6 h-6 stroke-[2]" />
                </button>
                <button 
                  onClick={() => showToast('Speed challenge started! Ready... 3, 2, 1 🥊', 'success')}
                  className="w-12 h-12 rounded-full border border-neutral-500 bg-neutral-900 flex items-center justify-center text-white font-extrabold text-[10px] tracking-wider hover:border-[#a3e635] hover:text-[#a3e635] active:scale-95 transition-all shadow-md"
                >
                  PLAY
                </button>
                <button 
                  onClick={() => showToast('4 unread direct messages', 'info')}
                  className="flex flex-col items-center text-neutral-400 hover:text-white transition-colors relative"
                >
                  <MessageSquare className="w-6 h-6 stroke-[2]" />
                  <span className="absolute -top-1 -right-1.5 bg-rose-600 text-white font-bold text-[9px] w-4 h-4 rounded-full flex items-center justify-center border border-black">
                    4
                  </span>
                </button>
                <button 
                  onClick={() => {
                    setCurrentScreen('STEP_PROFILE');
                    showToast('Editing profile', 'info');
                  }}
                  className="flex flex-col items-center text-neutral-400 hover:text-white transition-colors"
                >
                  <User className="w-6 h-6 stroke-[2]" />
                </button>
              </div>

            </div>
          )}

        </div>

        {/* ========================================================
            MODAL 1: BOTTOM SIGN UP SHEET (From Login Screen)
        ======================================================== */}
        {showSignUpSheet && (
          <div className="absolute inset-0 z-50 bg-black/60 backdrop-blur-xs flex flex-col justify-end">
            <div className="bg-white text-black rounded-t-[36px] px-6 pt-5 pb-7 max-h-[90%] overflow-y-auto animate-in slide-in-from-bottom duration-300">
              <div className="flex items-center justify-between mb-4">
                <span className="text-base font-bold">Sign Up</span>
                <button 
                  onClick={() => setShowSignUpSheet(false)}
                  className="w-8 h-8 rounded-full flex items-center justify-center text-neutral-800 hover:bg-neutral-100"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>

              <h2 className="text-xl font-bold tracking-tight mb-5">Create your On account</h2>

              <div className="mb-4">
                <label className="text-xs text-neutral-500 font-medium block mb-1">Email</label>
                <div className="relative">
                  <input 
                    type="email"
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    placeholder="Enter your email"
                    className="w-full py-2 border-b border-neutral-300 text-sm focus:outline-none focus:border-black font-medium pr-8"
                  />
                  {email && email.includes('@') && (
                    <Check className="w-4 h-4 text-emerald-600 absolute right-1 top-1/2 -translate-y-1/2" />
                  )}
                </div>
              </div>

              <div className="mb-4">
                <label className="text-xs text-neutral-500 font-medium block mb-1">code</label>
                <div className="flex items-center justify-between border-b border-neutral-300">
                  <input 
                    type="text"
                    maxLength={6}
                    value={code}
                    onChange={(e) => setCode(e.target.value)}
                    placeholder="6-digit code"
                    className="w-1/2 py-2 text-sm tracking-wider font-semibold focus:outline-none"
                  />
                  <button 
                    type="button"
                    onClick={handleSendCode}
                    disabled={countdown > 0}
                    className={`text-xs font-semibold ${
                      countdown > 0 
                        ? 'text-neutral-400 cursor-not-allowed' 
                        : 'text-[#4d7c0f] hover:text-[#3f6212]'
                    }`}
                  >
                    {countdown > 0 ? `Send Code (${countdown})` : 'Send Code'}
                  </button>
                </div>
                {codeSent && (
                  <span className="text-[10px] text-neutral-400 mt-1 block">
                    Hint: Use code <strong className="text-neutral-700">212145</strong> or <strong className="text-neutral-700">123456</strong>
                  </span>
                )}
              </div>

              <label className="flex items-start space-x-2.5 text-[11px] text-neutral-700 cursor-pointer mb-2">
                <input 
                  type="checkbox" 
                  checked={agreedToTerms} 
                  onChange={(e) => setAgreedToTerms(e.target.checked)}
                  className="rounded mt-0.5 accent-black" 
                />
                <span className="font-semibold">Sign up for email updates from TekXYZ</span>
              </label>

              <p className="text-[10px] text-neutral-500 mb-6 pl-6">
                I agree to the <span className="underline">Terms of Service & Privacy Policy</span>
              </p>

              <button 
                onClick={handleVerifyAndContinue}
                className={`w-full h-12 rounded-full font-semibold text-sm transition-all mb-4 ${
                  email && code 
                    ? 'bg-[#a3e635] text-black hover:bg-[#84cc16]' 
                    : 'bg-neutral-300 text-neutral-600'
                }`}
              >
                Continue
              </button>

              <div className="space-y-2.5 pt-1">
                <button 
                  onClick={() => handleThirdPartyAuth('Apple')}
                  className="w-full h-11 rounded-full border border-neutral-300 flex items-center justify-center space-x-2 text-xs font-semibold text-neutral-900 hover:bg-neutral-50 transition-colors"
                >
                  <svg className="w-4 h-4 fill-current" viewBox="0 0 170 170">
                    <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.08-7.85-8.1-12.48-15.06-6.19-9.35-11.02-20.08-14.49-32.2-3.47-12.12-5.21-23.51-5.21-34.17 0-15.52 3.86-28.09 11.59-37.71 7.73-9.62 17.5-14.51 29.31-14.67 4.7 0 9.87 1.15 15.51 3.44 5.64 2.29 9.38 3.5 11.22 3.64 1.48-.14 5.4-1.41 11.77-3.81 6.37-2.4 11.83-3.44 16.39-3.12 12.08.64 21.84 5.16 29.28 13.56-10.59 6.43-15.78 15.42-15.57 26.97.22 9.04 3.68 16.71 10.38 23.01 6.7 6.3 14.69 10.02 23.97 11.16-2.02 6.09-4.52 12.44-7.51 19.06z" />
                  </svg>
                  <span>Continue with Apple</span>
                </button>

                <button 
                  onClick={() => handleThirdPartyAuth('Google')}
                  className="w-full h-11 rounded-full border border-neutral-300 flex items-center justify-center space-x-2 text-xs font-semibold text-neutral-900 hover:bg-neutral-50 transition-colors"
                >
                  <svg className="w-4 h-4" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z"/>
                    <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.98 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                  </svg>
                  <span>Continue with Google</span>
                </button>
              </div>
            </div>
          </div>
        )}

        {/* ========================================================
            MODAL 2: SEARCHABLE COUNTRY SELECTOR SHEET
        ======================================================== */}
        {showCountryModal && (
          <div className="absolute inset-0 z-50 bg-black/70 backdrop-blur-xs flex flex-col justify-end">
            <div className="bg-white text-black rounded-t-[36px] pt-4 pb-6 h-[85%] flex flex-col animate-in slide-in-from-bottom duration-300">
              <div className="flex items-center justify-between px-6 mb-3">
                <button 
                  onClick={() => setShowCountryModal(false)}
                  className="w-7 h-7 rounded-full bg-neutral-200 flex items-center justify-center text-neutral-600 hover:bg-neutral-300"
                >
                  <X className="w-4 h-4" />
                </button>
                <div className="w-10 h-1 bg-neutral-300 rounded-full" />
                <div className="w-7" />
              </div>

              <div className="px-6 mb-3">
                <div className="flex items-center bg-neutral-100 rounded-2xl px-3 py-2 border border-neutral-200">
                  <Search className="w-4 h-4 text-neutral-400 mr-2 shrink-0" />
                  <input 
                    type="text"
                    value={countrySearch}
                    onChange={(e) => setCountrySearch(e.target.value)}
                    placeholder="Search"
                    className="w-full bg-transparent text-sm focus:outline-none"
                  />
                  {countrySearch && (
                    <button onClick={() => setCountrySearch('')}>
                      <X className="w-3.5 h-3.5 text-neutral-400" />
                    </button>
                  )}
                </div>
              </div>

              <div className="flex-1 overflow-y-auto px-6 divide-y divide-neutral-100">
                {filteredCountries.map((c) => {
                  const isSelected = country === c;
                  return (
                    <div 
                      key={c}
                      onClick={() => {
                        setCountry(c);
                        setShowCountryModal(false);
                      }}
                      className="py-3.5 flex items-center justify-between cursor-pointer hover:bg-neutral-50 transition-colors"
                    >
                      <span className="text-sm font-medium text-neutral-800">{c}</span>
                      <div className={`w-5 h-5 rounded-full border flex items-center justify-center ${
                        isSelected 
                          ? 'border-blue-600 bg-blue-600 text-white' 
                          : 'border-neutral-300'
                      }`}>
                        {isSelected && <Check className="w-3 h-3 stroke-[3]" />}
                      </div>
                    </div>
                  );
                })}
                {filteredCountries.length === 0 && (
                  <div className="text-center py-10 text-neutral-400 text-sm">
                    No countries matching "{countrySearch}"
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        {/* ========================================================
            MODAL 3: AVATAR PICKER SHEET
        ======================================================== */}
        {showAvatarPickerModal && (
          <div className="absolute inset-0 z-50 bg-black/70 backdrop-blur-xs flex flex-col justify-end">
            <div className="bg-neutral-900 border-t border-neutral-800 text-white rounded-t-[32px] px-6 pt-5 pb-7 animate-in slide-in-from-bottom duration-300">
              <div className="flex justify-between items-center mb-4">
                <span className="text-sm font-semibold">Select Avatar</span>
                <button onClick={() => setShowAvatarPickerModal(false)} className="text-neutral-400 hover:text-white">
                  <X className="w-4 h-4" />
                </button>
              </div>

              <div className="grid grid-cols-2 gap-3 mb-5">
                <button 
                  onClick={() => handleSelectMockPhoto('camera')}
                  className="flex flex-col items-center justify-center p-4 rounded-2xl bg-neutral-800 border border-neutral-700/60 hover:border-[#a3e635] transition-all"
                >
                  <Camera className="w-6 h-6 text-[#a3e635] mb-1.5" />
                  <span className="text-xs font-medium">Take Photo</span>
                </button>

                <button 
                  onClick={() => handleSelectMockPhoto('album')}
                  className="flex flex-col items-center justify-center p-4 rounded-2xl bg-neutral-800 border border-neutral-700/60 hover:border-[#a3e635] transition-all"
                >
                  <ImageIcon className="w-6 h-6 text-[#a3e635] mb-1.5" />
                  <span className="text-xs font-medium">Choose from Album</span>
                </button>
              </div>

              <span className="text-xs text-neutral-400 block mb-2 font-medium">Or choose a preset:</span>
              <div className="flex justify-around items-center pt-1 pb-3">
                {AVATAR_OPTIONS.map((opt) => (
                  <div 
                    key={opt.id}
                    onClick={() => {
                      setSelectedAvatar(opt);
                      setCustomAvatarUrl(null);
                      setShowAvatarPickerModal(false);
                      showToast(`Selected ${opt.label} avatar`, 'success');
                    }}
                    className={`w-12 h-12 rounded-full cursor-pointer flex items-center justify-center transition-transform hover:scale-105 ${
                      selectedAvatar.id === opt.id && !customAvatarUrl
                        ? 'ring-2 ring-[#a3e635] ring-offset-2 ring-offset-neutral-900' 
                        : ''
                    }`}
                    style={{ backgroundColor: opt.bg }}
                  >
                    <User className="w-5 h-5 text-black" />
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ========================================================
            MODAL 4: FITNESS WHEEL PICKERS (HEIGHT, WEIGHT, DOB, GENDER)
        ======================================================== */}
        {activePicker && (
          <div className="absolute inset-0 z-50 bg-black/60 backdrop-blur-xs flex flex-col justify-end">
            <div className="bg-white text-black rounded-t-[36px] px-6 pt-5 pb-6 animate-in slide-in-from-bottom duration-300">
              
              {/* Header with Title and Skip */}
              <div className="flex items-center justify-between mb-1">
                <span className="text-base font-bold text-neutral-900">
                  {activePicker === 'height' && 'Select your height'}
                  {activePicker === 'weight' && 'Select your weight'}
                  {activePicker === 'dob' && 'Date of Birth'}
                  {activePicker === 'gender' && 'Select your gender'}
                </span>
                <button 
                  onClick={() => setActivePicker(null)}
                  className="text-xs text-blue-600 font-semibold hover:underline"
                >
                  Skip
                </button>
              </div>

              <p className="text-[11px] text-neutral-500 mb-3">
                This helps us personalize your fitness targets. Your data stays private and secure.
              </p>

              {/* 1. HEIGHT PICKER: Dual Mode (cm or ft/in) with Scroll Wheels */}
              {activePicker === 'height' && (
                <div className="py-2">
                  {/* Unit Segmented Control Pill matching mockups */}
                  <div className="flex bg-neutral-100 p-1 rounded-full mb-3 text-xs font-semibold border border-neutral-200">
                    <button 
                      onClick={() => setHeightUnit('cm')}
                      className={`flex-1 py-1.5 rounded-full transition-all duration-200 ${
                        heightUnit === 'cm' 
                          ? 'bg-white shadow-sm text-black font-bold' 
                          : 'text-neutral-500 hover:text-neutral-800'
                      }`}
                    >
                      cm
                    </button>
                    <button 
                      onClick={() => setHeightUnit('ft/in')}
                      className={`flex-1 py-1.5 rounded-full transition-all duration-200 ${
                        heightUnit === 'ft/in' 
                          ? 'bg-white shadow-sm text-black font-bold' 
                          : 'text-neutral-500 hover:text-neutral-800'
                      }`}
                    >
                      ft / in
                    </button>
                  </div>

                  {/* Wheel container based on chosen unit */}
                  {heightUnit === 'cm' ? (
                    <div className="flex justify-center">
                      <WheelPicker 
                        items={cmList}
                        selectedValue={selectedCm}
                        onValueChange={(val) => setSelectedCm(val)}
                        labelSuffix="cm"
                        width="w-full"
                      />
                    </div>
                  ) : (
                    <div className="flex justify-center items-center space-x-2">
                      <WheelPicker 
                        items={ftList}
                        selectedValue={selectedFt}
                        onValueChange={(val) => setSelectedFt(val)}
                        labelSuffix="ft"
                        width="w-1/2"
                      />
                      <WheelPicker 
                        items={inList}
                        selectedValue={selectedIn}
                        onValueChange={(val) => setSelectedIn(val)}
                        labelSuffix="in"
                        width="w-1/2"
                      />
                    </div>
                  )}
                </div>
              )}

              {/* 2. WEIGHT PICKER: Dual Mode (kg or lbs) with Scroll Wheels */}
              {activePicker === 'weight' && (
                <div className="py-2">
                  {/* Segmented Control Pill */}
                  <div className="flex bg-neutral-100 p-1 rounded-full mb-3 text-xs font-semibold border border-neutral-200">
                    <button 
                      onClick={() => setWeightUnit('kg')}
                      className={`flex-1 py-1.5 rounded-full transition-all duration-200 ${
                        weightUnit === 'kg' 
                          ? 'bg-white shadow-sm text-black font-bold' 
                          : 'text-neutral-500 hover:text-neutral-800'
                      }`}
                    >
                      kg
                    </button>
                    <button 
                      onClick={() => setWeightUnit('lbs')}
                      className={`flex-1 py-1.5 rounded-full transition-all duration-200 ${
                        weightUnit === 'lbs' 
                          ? 'bg-white shadow-sm text-black font-bold' 
                          : 'text-neutral-500 hover:text-neutral-800'
                      }`}
                    >
                      lbs
                    </button>
                  </div>

                  {/* Weight Wheel Picker */}
                  <div className="flex justify-center">
                    {weightUnit === 'kg' ? (
                      <WheelPicker 
                        items={kgList}
                        selectedValue={selectedKg}
                        onValueChange={(val) => setSelectedKg(val)}
                        labelSuffix="kg"
                        width="w-full"
                      />
                    ) : (
                      <WheelPicker 
                        items={lbsList}
                        selectedValue={selectedLbs}
                        onValueChange={(val) => setSelectedLbs(val)}
                        labelSuffix="lbs"
                        width="w-full"
                      />
                    )}
                  </div>
                </div>
              )}

              {/* 3. DATE OF BIRTH PICKER: Triple Column Wheel (Month, Day, Year) */}
              {activePicker === 'dob' && (
                <div className="py-2 flex justify-center items-center space-x-1">
                  <WheelPicker 
                    items={MONTHS}
                    selectedValue={selectedMonth}
                    onValueChange={(val) => setSelectedMonth(val)}
                    width="w-1/3"
                  />
                  <WheelPicker 
                    items={daysList}
                    selectedValue={selectedDay}
                    onValueChange={(val) => setSelectedDay(val)}
                    width="w-1/3"
                  />
                  <WheelPicker 
                    items={yearsList}
                    selectedValue={selectedYear}
                    onValueChange={(val) => setSelectedYear(val)}
                    width="w-1/3"
                  />
                </div>
              )}

              {/* 4. GENDER PICKER: Vertical Wheel Picker */}
              {activePicker === 'gender' && (
                <div className="py-2 flex justify-center">
                  <WheelPicker 
                    items={genderList}
                    selectedValue={selectedGender}
                    onValueChange={(val) => setSelectedGender(val)}
                    width="w-full"
                  />
                </div>
              )}

              {/* Confirmation Select Button */}
              <button 
                onClick={() => {
                  if (activePicker === 'height') {
                    const formatted = heightUnit === 'cm' 
                      ? `${selectedCm} cm` 
                      : `${selectedFt} ft ${selectedIn} in`;
                    setFitnessData(prev => ({ ...prev, height: formatted }));
                    showToast(`Height set to ${formatted}`, 'success');
                  } else if (activePicker === 'weight') {
                    const formatted = weightUnit === 'kg' 
                      ? `${selectedKg} kg` 
                      : `${selectedLbs} lbs`;
                    setFitnessData(prev => ({ ...prev, weight: formatted }));
                    showToast(`Weight set to ${formatted}`, 'success');
                  } else if (activePicker === 'dob') {
                    const dayPadded = String(selectedDay).padStart(2, '0');
                    const formatted = `${selectedMonth} ${dayPadded}, ${selectedYear}`;
                    setFitnessData(prev => ({ ...prev, dob: formatted }));
                    showToast(`DOB set to ${formatted}`, 'success');
                  } else if (activePicker === 'gender') {
                    setFitnessData(prev => ({ ...prev, gender: selectedGender }));
                    showToast(`Gender set to ${selectedGender}`, 'success');
                  }
                  setActivePicker(null);
                }}
                className="w-full h-12 bg-neutral-900 text-white font-semibold rounded-full text-sm mt-3 hover:bg-black active:scale-[0.99] transition-all shadow-md"
              >
                Select
              </button>

            </div>
          </div>
        )}

        {/* iPhone Home Indicator */}
        <div className="w-full flex justify-center pb-2 pt-1 pointer-events-none">
          <div className="w-32 h-1 bg-neutral-700/80 rounded-full" />
        </div>

      </div>

    </div>
  );
}
