                >
                  Skip
                </button>
                <button 
                  onClick={() => handleCompleteSignUp(false)}
                  className="flex-1 h-12 rounded-full bg-[#a3e635] text-black font-semibold text-sm hover:bg-[#84cc16] transition-colors shadow-[0_4px_16px_rgba(163,230,53,0.3)]"
                >
                  Sign Up
                </button>
              </div>
            </div>
          )}

          {/* ========================================================
              SCREEN 4: APP HOME DASHBOARD (Matching image_f5a603.jpg)
          ======================================================== */}
          {currentScreen === 'HOME' && (
            <div className="absolute inset-0 z-10 bg-black flex flex-col justify-between overflow-hidden">
              <div className="absolute inset-0 pointer-events-none">
                <img 
                  src="https://images.unsplash.com/photo-1549719386-74dfcbf7dbed?auto=format&fit=crop&w=800&q=80" 
                  alt="Boxing Workout" 
                  className="w-full h-full object-cover opacity-90 scale-105"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-black/60" />
              </div>

              {/* Top Status & Challenge Bar */}
              <div className="relative z-20 pt-10 px-4">
                <div className="flex items-center justify-between">
                  <div className="flex-1 mr-2 bg-neutral-900/80 backdrop-blur-md border border-neutral-700/60 rounded-2xl px-3.5 py-1.5 flex items-center justify-between text-xs">
                    <span className="text-white/90 font-medium truncate max-w-[190px]">
                      The May '26 Speed King Challe...
                    </span>
                    <div className="flex items-center space-x-1 shrink-0 pl-2">
                      <span className="w-2 h-2 rounded-full bg-emerald-400 inline-block animate-pulse" />
                      <span className="text-[11px] text-neutral-300 font-medium">Online</span>
                      <span className="text-[11px] text-neutral-400">3</span>
                    </div>
                  </div>

                  <button 
                    onClick={() => {
                      setCurrentScreen('LOGIN');
                      showToast('Returned to login screen for testing', 'info');
